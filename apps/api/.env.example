# 本地开发用环境变量模板（复制为 .env，不要提交）
# 数据库不装本地：用 SSH 隧道连线上 MySQL
#   ssh -N -L 13306:127.0.0.1:3306 templio-server
NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://templio_user:CHANGE_ME@127.0.0.1:13306/templio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
STORAGE_ROOT=./storage
APP_ORIGIN=http://127.0.0.1:5173

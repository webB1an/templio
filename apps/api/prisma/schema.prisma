// Templio 数据模型（P0）
// 只包含一期需要的核心模型；支付/订单等商业化模型后续通过新 migration 增加。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TemplateStatus {
  draft
  imported
  ai_processing
  pending_review
  published
  rejected
  archived
  failed
}

enum TemplateFileRole {
  source
  preview
  thumb
  cover
}

enum StorageProvider {
  baidu
  quark
}

enum NetdiskLinkStatus {
  pending
  synced
  invalid
}

enum TaskType {
  netdisk_sync
  ai_classify
}

enum TaskStatus {
  queued
  running
  success
  failed
  skipped
}

model Template {
  id            String         @id @default(cuid())
  sourceHash    String         @unique @db.Char(64)
  title         String?        @db.VarChar(200)
  subtitle      String?        @db.VarChar(200)
  description   String?        @db.Text
  status        TemplateStatus @default(draft)
  categoryId    String?
  format        String?        @db.VarChar(16)
  pageCount     Int?
  fileSize      BigInt?
  originalName  String?        @db.VarChar(255)
  batchKey      String?        @db.VarChar(64)
  textContent   Json?
  viewCount     Int            @default(0)
  copyCount     Int            @default(0)
  favoriteCount Int            @default(0)
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  category     Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  files        TemplateFile[]
  tags         TemplateTag[]
  netdiskLinks NetdiskLink[]
  shortLinks   ShortLink[]
  aiAnalysis   AiAnalysis?
  favorites    UserFavorite[]
  clicks       TemplateClick[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([batchKey])
}

model TemplateFile {
  id         String           @id @default(cuid())
  templateId String
  role       TemplateFileRole
  objectKey  String           @db.VarChar(512)
  mime       String?          @db.VarChar(100)
  size       BigInt?
  width      Int?
  height     Int?
  seq        Int              @default(0)
  createdAt  DateTime         @default(now())
  template   Template         @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, role, seq])
}

model Category {
  id        String     @id @default(cuid())
  parentId  String?
  name      String     @db.VarChar(100)
  slug      String     @unique @db.VarChar(100)
  icon      String?    @db.VarChar(255)
  sort      Int        @default(0)
  createdAt DateTime   @default(now())
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  templates Template[]
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique @db.VarChar(50)
  type      String        @default("style") @db.VarChar(20)
  createdAt DateTime      @default(now())
  templates TemplateTag[]
}

model TemplateTag {
  templateId String
  tagId      String
  sort       Int      @default(0)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([templateId, tagId])
}

model StorageAccount {
  id               String          @id @default(cuid())
  provider         StorageProvider
  label            String          @db.VarChar(64)
  profileDir       String          @db.VarChar(512)
  configPath       String?         @db.VarChar(512)
  accountName      String?         @db.VarChar(128)
  isDefault        Boolean         @default(false)
  isActive         Boolean         @default(true)
  lastProbeOk      Boolean?
  lastProbeMessage String?         @db.Text
  lastProbeAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([provider, isDefault])
  @@index([provider, isActive])
}

model NetdiskLink {
  id               String            @id @default(cuid())
  templateId       String
  provider         StorageProvider
  storageAccountId String?
  url              String            @db.Text
  passcode         String?           @db.VarChar(32)
  remotePath       String?           @db.VarChar(512)
  remoteFileId     String?           @db.VarChar(128)
  status           NetdiskLinkStatus @default(pending)
  isPrimary        Boolean           @default(false)
  isActive         Boolean           @default(true)
  lastCheckedAt    DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  template         Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  shortLinks       ShortLink[]

  @@index([templateId, provider])
  @@index([status, isActive])
}

model ShortLink {
  id            String          @id @default(cuid())
  code          String          @unique @db.VarChar(32)
  templateId    String
  netdiskLinkId String
  provider      StorageProvider
  clickCount    Int             @default(0)
  createdAt     DateTime        @default(now())
  template      Template        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  netdiskLink   NetdiskLink     @relation(fields: [netdiskLinkId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model AiAnalysis {
  id            String   @id @default(cuid())
  templateId    String   @unique
  title         String?  @db.VarChar(200)
  subtitle      String?  @db.VarChar(200)
  categoryKey   String?  @db.VarChar(100)
  tags          Json?
  audience      String?  @db.VarChar(50)
  style         String?  @db.VarChar(50)
  summary       String?  @db.Text
  confidence    Float?
  safe          Boolean  @default(true)
  flags         Json?
  needsReview   Boolean  @default(true)
  raw           Json?
  model         String?  @db.VarChar(100)
  promptVersion String?  @db.VarChar(50)
  inputTokens   Int?
  outputTokens  Int?
  createdAt     DateTime @default(now())
  template      Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Task {
  id         String     @id @default(cuid())
  templateId String?
  type       TaskType
  status     TaskStatus @default(queued)
  progress   Int        @default(0)
  message    String?    @db.Text
  payload    Json?
  result     Json?
  error      String?    @db.Text
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([type, status])
  @@index([templateId])
}

model Setting {
  key       String   @id @db.VarChar(100)
  value     Json?
  updatedAt DateTime @updatedAt
}

model User {
  id        String         @id @default(cuid())
  openid    String         @unique @db.VarChar(64)
  nickname  String?        @db.VarChar(100)
  avatar    String?        @db.VarChar(500)
  createdAt DateTime       @default(now())
  favorites UserFavorite[]
}

model UserFavorite {
  userId     String
  templateId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([userId, templateId])
}

model TemplateClick {
  id         String   @id @default(cuid())
  templateId String
  kind       String   @db.VarChar(20)
  userId     String?
  createdAt  DateTime @default(now())
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, kind, createdAt])
}

<view class="nav" style="padding-top: {{navTop}}px;">
  <view class="nav-inner" style="margin-right: {{menuRight}}px;">
    <text class="brand">模板宝</text>
    <text class="brand-sub">模板库</text>
  </view>
</view>

<view class="page home-page" style="padding-top: {{contentTop}}px;">
  <view class="hero">
    <text class="hero-title">选一份好用的模板</text>
    <text class="hero-sub">PPT / Word · 商务、答辩、求职与教学</text>
  </view>

  <view class="search" bindtap="goSearch">
    <text class="search-icon">⌕</text>
    <text class="search-text">搜索模板、场景或风格</text>
  </view>

  <view class="section-head">
    <text class="section-title">最近更新</text>
    <text class="section-more" bindtap="goList">查看全部 ›</text>
  </view>

  <view class="grid">
    <view class="grid-item" wx:for="{{templates}}" wx:key="id">
      <template-card item="{{item}}" bind:open="onOpenCard" />
    </view>
  </view>

  <view class="list-tip" wx:if="{{loading}}">加载中…</view>
  <view class="list-tip" wx:if="{{!loading && templates.length === 0}}">暂无模板</view>
  <view class="list-tip" wx:if="{{!loading && !hasMore && templates.length}}">已经到底了</view>

  <view class="tabbar-pad"></view>
</view>

<scroll-view class="category-dock" scroll-x enhanced show-scrollbar="{{false}}">
  <view
    wx:for="{{categories}}"
    wx:key="key"
    class="dock-item {{activeCategory === item.key ? 'dock-active' : ''}}"
    data-key="{{item.key}}"
    bindtap="onCategory"
  >{{item.name}}</view>
</scroll-view>

<view class="nav" style="padding-top: {{navTop}}px;">
  <view class="nav-inner" style="margin-right: {{menuRight}}px;">
    <text class="brand">模板宝</text>
    <text class="brand-sub">模板库</text>
  </view>
</view>

<view class="page" style="padding-top: {{contentTop}}px;">
  <view class="hero">
    <text class="hero-title">选一份好用的模板</text>
    <text class="hero-sub">PPT / Word · 商务、答辩、求职与教学</text>
  </view>

  <view class="search" bindtap="goSearch">
    <text class="search-icon">⌕</text>
    <text class="search-text">搜索模板、场景或风格</text>
  </view>

  <scroll-view class="chips" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="key"
      class="chip {{activeCategory === item.key ? 'chip-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onCategory"
    >{{item.name}}</view>
  </scroll-view>

  <view class="section-head">
    <text class="section-title">精选模板</text>
    <text class="section-more" bindtap="goList">查看全部 ›</text>
  </view>

  <view class="grid">
    <view
      wx:for="{{templates}}"
      wx:key="id"
      class="card"
      data-id="{{item.id}}"
      bindtap="openDetail"
      hover-class="card-hover"
    >
      <view class="cover tone-{{item.tone}}">
        <image wx:if="{{item.coverUrl}}" class="cover-img" src="{{item.coverUrl}}" mode="aspectFill" lazy-load binderror="onCoverError" data-index="{{index}}" />
        <text class="cover-format">{{item.format}}</text>
        <text wx:if="{{!item.coverUrl}}" class="cover-title">{{item.title}}</text>
      </view>
      <view class="card-body">
        <text class="card-title">{{item.title}}</text>
        <view class="card-meta">
          <text>{{item.category}}</text>
          <text>{{item.pageCount}} 页</text>
        </view>
      </view>
    </view>
  </view>

  <view class="list-tip" wx:if="{{loading}}">加载中…</view>
  <view class="list-tip" wx:if="{{!loading && templates.length === 0}}">暂无模板</view>
  <view class="list-tip" wx:if="{{!loading && !hasMore && templates.length}}">已经到底了</view>

  <view class="footer-tip">模板内容仅供学习与交流，版权归原作者所有</view>
  <view class="tabbar-pad"></view>
</view>

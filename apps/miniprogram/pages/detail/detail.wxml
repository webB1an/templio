<view wx:if="{{item}}" class="detail-page">
  <view class="bg-orb orb-a"></view>
  <view class="bg-orb orb-b"></view>

  <view class="detail-nav" style="padding-top: {{navTop}}px; height: {{navHeight}}px;">
    <view class="nav-back glass" bindtap="goBack">‹</view>
  </view>

  <view class="detail-hero tone-{{item.tone}}">
    <text class="hero-format">{{item.format}}</text>
    <text class="hero-text">{{item.title}}</text>
  </view>

  <view class="detail-body">
    <view class="info-card glass">
      <text class="detail-title">{{item.title}}</text>

      <view class="meta-row">
        <text class="meta-pill">{{item.format}}</text>
        <text class="meta-pill">{{item.pageCount}} 页</text>
        <text class="meta-pill">{{item.sizeText}}</text>
        <text class="meta-pill">{{item.category}}</text>
      </view>

      <view class="tag-row">
        <text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text>
      </view>

      <text class="summary">{{item.summary}}</text>
    </view>

    <view class="get-card glass">
      <view class="get-head">
        <text class="get-label">网盘下载</text>
        <text class="get-hint">复制后打开网盘 App 保存</text>
      </view>

      <view class="link-box">
        <text class="link-text">{{item.shortLink}}</text>
        <text wx:if="{{item.passcode}}" class="passcode">提取码 {{item.passcode}}</text>
      </view>

      <view class="get-actions">
        <button class="copy-btn" bindtap="copyLink">复制链接和提取码</button>
        <button class="fav-btn {{fav ? 'fav-on' : ''}}" bindtap="toggleFav">
          {{fav ? "已收藏" : "收藏"}}
        </button>
      </view>
    </view>

    <view class="steps glass">
      <text class="steps-title">使用说明</text>
      <view class="step-row">
        <text class="step-no">1</text>
        <text class="step-text">复制链接和提取码</text>
      </view>
      <view class="step-row">
        <text class="step-no">2</text>
        <text class="step-text">打开百度/夸克网盘 App，保存到我的网盘</text>
      </view>
      <view class="step-row">
        <text class="step-no">3</text>
        <text class="step-text">在电脑上登录网盘下载，用 Office / WPS 打开编辑</text>
      </view>
    </view>

    <view wx:if="{{related.length}}" class="section-head">
      <text class="section-title">相关模板</text>
    </view>

    <view class="grid">
      <view
        wx:for="{{related}}"
        wx:key="id"
        class="card"
        data-id="{{item.id}}"
        bindtap="openRelated"
      >
        <view class="cover tone-{{item.tone}}">
          <text class="cover-format">{{item.format}}</text>
          <text class="cover-title">{{item.title}}</text>
        </view>
        <view class="card-body">
          <text class="card-title">{{item.title}}</text>
          <view class="card-meta">
            <text>{{item.category}}</text>
            <text>{{item.pageCount}} 页</text>
          </view>
        </view>
      </view>
    </view>

    <view class="footer-tip">模板仅供学习交流使用，版权归原作者所有</view>
    <view class="tabbar-pad"></view>
  </view>
</view>

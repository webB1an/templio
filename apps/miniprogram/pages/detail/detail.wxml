<view wx:if="{{item}}" class="detail-page">
  <view class="detail-nav" style="padding-top: {{navTop}}px;">
    <view class="nav-back detail-back" bindtap="goBack">‹</view>
  </view>

  <view class="detail-hero tone-{{item.tone}}">
    <image wx:if="{{item.coverUrl}}" class="hero-img" src="{{item.coverUrl}}" mode="aspectFill" binderror="onCoverError" />
    <text class="hero-format">{{item.format}}</text>
    <view wx:if="{{!item.coverUrl}}" class="hero-fallback">
      <text class="hero-fallback-format">{{item.formatLabel || item.format}}</text>
    </view>
  </view>

  <view class="detail-body">
    <view class="info-block">
      <text class="detail-title">{{item.title}}</text>

      <view class="meta-line">
        <text>{{item.format}}</text>
        <text class="meta-dot">·</text>
        <text>{{item.pageCount}} 页</text>
        <text class="meta-dot">·</text>
        <text>{{item.sizeText}}</text>
        <text class="meta-dot">·</text>
        <text>{{item.category}}</text>
      </view>

      <view class="tag-row" wx:if="{{item.tags.length}}">
        <text wx:for="{{item.tags}}" wx:key="*this" class="tag">#{{item}}</text>
      </view>

      <text class="summary">{{item.summary}}</text>
    </view>

    <scroll-view wx:if="{{item.previewUrls && item.previewUrls.length}}" class="preview-strip" scroll-x enhanced show-scrollbar="{{false}}">
      <image
        wx:for="{{item.previewUrls}}"
        wx:key="*this"
        class="preview-thumb"
        src="{{item}}"
        mode="aspectFill"
        lazy-load
        bindtap="previewImage"
        data-src="{{item}}"
      />
    </scroll-view>

    <view class="get-block">
      <view class="get-head">
        <text class="get-label">获取模板</text>
        <text class="get-hint">复制后打开网盘 App 保存</text>
      </view>

      <view class="link-box">
        <text class="link-text">{{item.shortLink}}</text>
        <text wx:if="{{item.passcode}}" class="passcode">提取码 {{item.passcode}}</text>
      </view>

      <view class="get-actions">
        <button class="btn-dark copy-btn" bindtap="copyLink">复制链接和提取码</button>
        <button class="btn-outline fav-btn {{fav ? 'fav-on' : ''}}" bindtap="toggleFav">
          {{fav ? "已收藏" : "收藏"}}
        </button>
      </view>
    </view>

    <view class="steps-block">
      <text class="steps-title">使用说明</text>
      <view class="step-row">
        <text class="step-no">01</text>
        <text class="step-text">复制链接和提取码</text>
      </view>
      <view class="step-row">
        <text class="step-no">02</text>
        <text class="step-text">打开百度 / 夸克网盘 App，保存到我的网盘</text>
      </view>
      <view class="step-row">
        <text class="step-no">03</text>
        <text class="step-text">在电脑上登录网盘下载，用 Office / WPS 打开编辑</text>
      </view>
    </view>

    <view wx:if="{{related.length}}" class="section-head">
      <text class="section-title">相关模板</text>
    </view>

    <view class="grid">
      <view class="grid-item" wx:for="{{related}}" wx:key="id">
        <template-card item="{{item}}" bind:open="onOpenRelatedCard" />
      </view>
    </view>

    <view class="footer-tip">模板仅供学习交流使用，版权归原作者所有</view>
    <view class="tabbar-pad"></view>
  </view>
</view>

<view wx:if="{{!item}}" class="detail-state">
  <text class="detail-state-text">{{loadError ? "模板不存在或加载失败" : "加载中…"}}</text>
  <view wx:if="{{loadError}}" class="detail-state-actions">
    <button class="btn-outline detail-state-btn" bindtap="retryLoad">重试</button>
    <button class="btn-outline detail-state-btn" bindtap="goBack">返回</button>
  </view>
</view>

<view wx:else class="detail-page">
  <view class="detail-nav" style="padding-top: {{navTop}}px;">
    <view class="nav-back detail-back" bindtap="goBack">‹</view>
  </view>

  <view class="detail-hero tone-{{item.tone}}" bindtap="previewImage">
    <image wx:if="{{item.coverUrl}}" class="hero-img" src="{{item.coverUrl}}" mode="aspectFill" binderror="onCoverError" />
    <text class="hero-format">{{item.format}}</text>
    <view wx:if="{{!item.coverUrl}}" class="hero-fallback">
      <text class="hero-fallback-format">{{item.formatLabel || item.format}}</text>
    </view>
  </view>

  <view class="detail-body">
    <view class="info-block">
      <text class="detail-title">{{item.title}}</text>

      <view class="meta-line">
        <text>{{item.format}}</text>
        <text class="meta-dot">·</text>
        <text>{{item.pageCount}} 页</text>
        <text class="meta-dot">·</text>
        <text>{{item.sizeText}}</text>
        <text class="meta-dot">·</text>
        <text>{{item.category}}</text>
      </view>

      <view class="tag-row" wx:if="{{item.tags.length}}">
        <text wx:for="{{item.tags}}" wx:key="*this" class="tag">#{{item}}</text>
      </view>

      <text class="summary">{{item.summary}}</text>
    </view>

    <view wx:if="{{item.previewUrls && item.previewUrls.length}}" class="preview-section">
      <view class="preview-head">
        <text class="section-title">模板预览</text>
        <text class="preview-count">共 {{item.previewUrls.length}} 页</text>
      </view>

      <scroll-view class="preview-strip" scroll-x enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{item.previewUrls}}"
          wx:key="*this"
          class="preview-item"
          data-src="{{item}}"
          bindtap="previewImage"
        >
          <image class="preview-thumb" src="{{item}}" mode="aspectFill" lazy-load />
          <text class="preview-page">{{index + 1}}</text>
        </view>
      </scroll-view>

      <text class="preview-hint">左右滑动 · 点击缩略图查看大图</text>
    </view>

    <view wx:else class="preview-empty">
      <text class="preview-empty-title">暂无页面预览</text>
      <text class="preview-empty-text">当前模板还没有上传页面缩略图，可先参考封面</text>
    </view>

    <view wx:if="{{related.length}}" class="section-head">
      <text class="section-title">相关模板</text>
    </view>

    <view class="grid">
      <view class="grid-item" wx:for="{{related}}" wx:key="id">
        <template-card item="{{item}}" bind:open="onOpenRelatedCard" />
      </view>
    </view>

    <view class="footer-tip">模板仅供学习交流使用，版权归原作者所有</view>
  </view>

  <view class="action-bar">
    <view class="action-group">
      <view class="action-item" bindtap="goBack">
        <image class="action-icon" src="/assets/icons/back.png" mode="aspectFit" />
        <text class="action-label">返回</text>
      </view>

      <view class="action-item" bindtap="toggleFav">
        <image class="action-icon" src="{{fav ? '/assets/icons/heart-filled.png' : '/assets/icons/heart.png'}}" mode="aspectFit" />
        <text class="action-label">{{fav ? "已收藏" : "收藏"}}</text>
      </view>

      <button class="action-item share-action" open-type="share">
        <image class="action-icon" src="/assets/icons/share.png" mode="aspectFit" />
        <text class="action-label">分享</text>
      </button>

      <view class="action-item" bindtap="reportTemplate">
        <image class="action-icon" src="/assets/icons/report.png" mode="aspectFit" />
        <text class="action-label">举报</text>
      </view>
    </view>

    <view class="action-primary {{item.shortLink ? '' : 'action-disabled'}}" bindtap="copyLink">{{item.shortLink ? "复制链接" : "暂无链接"}}</view>
  </view>
</view>

.detail-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.detail-state {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 0 48rpx;
  text-align: center;
}

.detail-state-text {
  font-size: 26rpx;
  color: var(--ink-3);
}

.detail-state-btn {
  width: 220rpx;
}

.detail-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  padding-right: 32rpx;
  box-sizing: border-box;
}

.detail-back {
  width: 68rpx;
  height: 68rpx;
  margin-left: 0;
  background: rgba(255, 255, 255, 0.62);
  -webkit-backdrop-filter: blur(26rpx) saturate(180%);
  backdrop-filter: blur(26rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 50%;
  font-size: 40rpx;
  box-shadow: 0 10rpx 24rpx rgba(31, 58, 100, 0.12);
}

.detail-hero {
  position: relative;
  height: 600rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  padding: 0 32rpx 36rpx;
  box-sizing: border-box;
  border-radius: 0 0 36rpx 36rpx;
}

.hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-format {
  position: absolute;
  top: 120rpx;
  right: 32rpx;
  z-index: 2;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: #ffffff;
  background: rgba(20, 24, 32, 0.36);
  -webkit-backdrop-filter: blur(14rpx);
  backdrop-filter: blur(14rpx);
}

.hero-fallback {
  position: relative;
  z-index: 2;
}

.hero-fallback-format {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.82);
}

.detail-body {
  padding: 0 28rpx;
}

.info-block {
  margin-top: 24rpx;
  padding: 30rpx 28rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  border-radius: 30rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 34rpx rgba(31, 58, 100, 0.08);
}

.detail-title {
  display: block;
  font-size: 38rpx;
  line-height: 1.42;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.meta-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.meta-dot {
  margin: 0 10rpx;
  color: rgba(60, 60, 67, 0.26);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  margin-right: 16rpx;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.summary {
  display: block;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  font-size: 25rpx;
  line-height: 1.75;
  color: var(--ink-2);
}

.preview-strip {
  margin-top: 22rpx;
  white-space: nowrap;
}

.preview-thumb {
  display: inline-block;
  width: 280rpx;
  height: 380rpx;
  margin-right: 14rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--glass-border);
  background: var(--glass);
  box-shadow: 0 10rpx 26rpx rgba(31, 58, 100, 0.08);
}

.get-block {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  border-radius: 30rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 34rpx rgba(31, 58, 100, 0.08);
}

.get-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.get-label {
  font-size: 29rpx;
  font-weight: 700;
}

.get-hint {
  font-size: 21rpx;
  color: var(--ink-3);
}

.link-box {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.46);
  border: 1rpx solid var(--line);
}

.link-text {
  display: block;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--ink-2);
  word-break: break-all;
}

.passcode {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--accent-ink);
}

.get-actions {
  display: flex;
  margin-top: 22rpx;
}

.copy-btn {
  flex: 1;
}

.fav-btn {
  width: 180rpx;
  margin-left: 16rpx;
}

.fav-on {
  color: #ffffff;
  border-color: rgba(10, 132, 255, 0.7);
  background: rgba(10, 132, 255, 0.86);
}

.steps-block {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  border-radius: 30rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 34rpx rgba(31, 58, 100, 0.08);
}

.steps-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.step-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.step-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.step-no {
  width: 52rpx;
  flex: none;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--accent);
  font-variant-numeric: tabular-nums;
}

.step-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--ink-2);
}

.detail-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.detail-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  padding-right: 32rpx;
  box-sizing: border-box;
}

.nav-back {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--ink);
}

.detail-hero {
  height: 620rpx;
  padding: 0 44rpx 120rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  border-radius: 0 0 56rpx 56rpx;
  position: relative;
  overflow: hidden;
}

.detail-hero::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0));
}

.hero-format {
  position: absolute;
  top: 96rpx;
  right: 40rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.95);
  background: rgba(0, 0, 0, 0.18);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.hero-text {
  position: relative;
  z-index: 1;
  color: #ffffff;
  font-size: 50rpx;
  line-height: 1.3;
  font-weight: 800;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.25);
}

.detail-body {
  position: relative;
  z-index: 2;
  padding: 0 32rpx;
  margin-top: -80rpx;
}

.info-card {
  padding: 36rpx 34rpx;
}

.detail-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.meta-pill {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  background: rgba(47, 107, 228, 0.08);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.tag {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--brand);
  background: rgba(47, 107, 228, 0.1);
}

.summary {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

/* 网盘获取卡 */
.get-card {
  margin-top: 28rpx;
  padding: 32rpx 34rpx;
}

.get-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.get-label {
  font-size: 30rpx;
  font-weight: 700;
}

.get-hint {
  font-size: 22rpx;
  color: var(--ink-3);
}

.link-box {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx dashed rgba(47, 107, 228, 0.35);
}

.link-text {
  display: block;
  font-size: 24rpx;
  color: var(--ink-2);
  word-break: break-all;
}

.passcode {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
}

.get-actions {
  display: flex;
  margin-top: 24rpx;
}

.copy-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #2f6be4 0%, #6a8dff 100%);
  box-shadow: 0 14rpx 30rpx rgba(47, 107, 228, 0.3);
  padding: 0;
  margin: 0;
}

.copy-btn::after {
  border: none;
}

.fav-btn {
  width: 190rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-left: 18rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  background: rgba(255, 255, 255, 0.7);
  padding: 0;
}

.fav-btn::after {
  border: none;
}

.fav-on {
  color: var(--brand);
  background: rgba(47, 107, 228, 0.12);
}

/* 使用说明 */
.steps {
  margin-top: 28rpx;
  padding: 32rpx 34rpx;
}

.steps-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.step-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.step-no {
  width: 38rpx;
  height: 38rpx;
  flex: none;
  border-radius: 50%;
  margin-right: 16rpx;
  font-size: 22rpx;
  line-height: 38rpx;
  text-align: center;
  color: #ffffff;
  background: var(--brand);
}

.step-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.detail-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.detail-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  padding-right: 32rpx;
  box-sizing: border-box;
}

.detail-back {
  width: 68rpx;
  height: 68rpx;
  margin-left: 0;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  font-size: 40rpx;
}

.detail-hero {
  position: relative;
  height: 600rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  padding: 0 36rpx 40rpx;
  box-sizing: border-box;
}

.hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-format {
  position: absolute;
  top: 120rpx;
  right: 36rpx;
  z-index: 2;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: #ffffff;
  background: rgba(25, 27, 30, 0.56);
}

.hero-fallback {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
}

.hero-fallback-format {
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.72);
}

.hero-fallback-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #ffffff;
}

.detail-body {
  padding: 0 32rpx;
}

.info-block {
  margin-top: 26rpx;
  padding: 30rpx 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
}

.detail-title {
  display: block;
  font-size: 38rpx;
  line-height: 1.42;
  font-weight: 700;
  letter-spacing: -0.6rpx;
}

.meta-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.meta-dot {
  margin: 0 10rpx;
  color: var(--line-strong);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  margin-right: 18rpx;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.summary {
  display: block;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  font-size: 25rpx;
  line-height: 1.75;
  color: var(--ink-2);
}

.preview-strip {
  margin-top: 24rpx;
  white-space: nowrap;
}

.preview-thumb {
  display: inline-block;
  width: 280rpx;
  height: 380rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--line);
  background: var(--paper-2);
}

.get-block {
  margin-top: 26rpx;
  padding: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
}

.get-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.get-label {
  font-size: 29rpx;
  font-weight: 700;
}

.get-hint {
  font-size: 21rpx;
  color: var(--ink-3);
}

.link-box {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 8rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
}

.link-text {
  display: block;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--ink-2);
  word-break: break-all;
}

.passcode {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--accent-ink);
}

.get-actions {
  display: flex;
  margin-top: 22rpx;
}

.copy-btn {
  flex: 1;
}

.fav-btn {
  width: 180rpx;
  margin-left: 16rpx;
}

.fav-on {
  color: var(--accent-ink);
  border-color: var(--accent);
  background: var(--accent-soft);
}

.steps-block {
  margin-top: 26rpx;
  padding: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
}

.steps-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.step-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.step-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.step-no {
  width: 52rpx;
  flex: none;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--accent);
  font-variant-numeric: tabular-nums;
}

.step-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--ink-2);
}

<view class="nav" style="padding-top: {{navTop}}px;">
  <view class="nav-inner" style="margin-right: {{menuRight}}px;">
    <text class="brand">分类</text>
    <text class="brand-sub">场景分类</text>
  </view>
</view>

<view class="page" style="padding-top: {{contentTop}}px;">
  <view class="hero">
    <text class="hero-title">按场景浏览</text>
    <text class="hero-sub">从主题出发，快速找到需要的模板</text>
  </view>

  <view class="cat-list">
    <view
      wx:for="{{categories}}"
      wx:key="key"
      class="cat-row"
      data-key="{{item.key}}"
      data-name="{{item.name}}"
      bindtap="openCategory"
      hover-class="cat-row-hover"
    >
      <text class="cat-index">{{item.ordinal}}</text>
      <view class="cat-main">
        <text class="cat-name">{{item.name}}</text>
        <text class="cat-count">{{item.count}} 个模板</text>
      </view>
      <text class="cat-arrow">→</text>
    </view>
  </view>

  <view class="footer-tip">分类与数量会随模板上架自动更新</view>
  <view class="tabbar-pad"></view>
</view>

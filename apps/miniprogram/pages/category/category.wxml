<view class="nav" style="padding-top: {{navTop}}px;">
  <view class="nav-inner" style="margin-right: {{menuRight}}px;">
    <text class="brand">分类</text>
    <text class="brand-sub">场景分类</text>
  </view>
</view>

<view class="page" style="padding-top: {{contentTop}}px;">
  <view class="hero">
    <text class="hero-title">按场景浏览</text>
    <text class="hero-sub">从主题出发，快速找到需要的模板</text>
  </view>

  <view class="category-grid">
    <view
      wx:for="{{categories}}"
      wx:key="key"
      class="category-card"
      data-key="{{item.key}}"
      data-name="{{item.name}}"
      bindtap="openCategory"
      hover-class="category-hover"
    >
      <view class="category-top">
        <view class="category-icon">{{item.initial}}</view>
        <text class="category-arrow">›</text>
      </view>
      <text class="category-name">{{item.name}}</text>
      <text class="category-count">{{item.count}} 个模板</text>
    </view>
  </view>

  <view class="footer-tip">分类与数量会随模板上架自动更新</view>
  <view class="tabbar-pad"></view>
</view>

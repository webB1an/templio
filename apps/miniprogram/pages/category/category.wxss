.cat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 48rpx;
}

.cat-card {
  width: 48.6%;
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
}

.cat-icon {
  font-size: 44rpx;
  color: var(--brand);
  line-height: 1;
}

.cat-name {
  margin-top: 26rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.cat-count {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

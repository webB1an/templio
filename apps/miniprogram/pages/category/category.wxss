.cat-list {
  margin-top: 42rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}

.cat-row {
  display: flex;
  align-items: center;
  min-height: 118rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid var(--line);
}

.cat-row:last-child {
  border-bottom: none;
}

.cat-row-hover {
  background: #faf8f4;
}

.cat-index {
  width: 64rpx;
  flex: none;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.cat-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 22rpx 0;
}

.cat-name {
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

.cat-count {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.cat-arrow {
  margin-left: 18rpx;
  font-size: 28rpx;
  color: var(--ink-3);
}

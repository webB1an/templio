.cat-list {
  margin-top: 38rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 34rpx rgba(31, 58, 100, 0.08);
}

.cat-row {
  display: flex;
  align-items: center;
  min-height: 118rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid var(--line);
}

.cat-row:last-child {
  border-bottom: none;
}

.cat-row-hover {
  background: rgba(255, 255, 255, 0.32);
}

.cat-index {
  width: 64rpx;
  flex: none;
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}

.cat-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 22rpx 0;
}

.cat-name {
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

.cat-count {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.cat-arrow {
  margin-left: 18rpx;
  font-size: 28rpx;
  color: var(--ink-3);
}

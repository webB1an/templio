.category-section-head {
  margin: 8rpx 4rpx 0;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 24rpx;
}

.category-card {
  width: 48.4%;
  margin-bottom: 22rpx;
  padding: 24rpx 22rpx 22rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  border-radius: 28rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 32rpx rgba(31, 58, 100, 0.08);
}

.category-hover {
  opacity: 0.82;
}

.category-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.category-icon {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--accent-ink);
  background: rgba(10, 132, 255, 0.12);
}

.category-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  color: var(--ink-3);
}

.category-name {
  margin-top: 26rpx;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

.category-count {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink-3);
}

.all-category-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 32rpx rgba(31, 58, 100, 0.08);
}

.all-category-copy {
  display: flex;
  flex-direction: column;
}

.all-category-title {
  font-size: 28rpx;
  font-weight: 600;
}

.all-category-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.all-category-arrow {
  width: 22rpx;
  height: 22rpx;
  color: var(--ink-3);
}

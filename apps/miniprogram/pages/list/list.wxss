.list-head {
  padding: 12rpx 0 30rpx;
}

.list-title {
  font-size: 44rpx;
}

.list-count {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.list-grid {
  margin-top: 10rpx;
}

.empty {
  margin-top: 40rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
}

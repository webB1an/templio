.downloads-tip {
  margin-top: 80rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}

.downloads-list {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 30rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 34rpx rgba(31, 58, 100, 0.08);
}

.download-row {
  display: flex;
  gap: 22rpx;
  padding: 22rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--line);
}

.download-row:last-child {
  border-bottom: none;
}

.download-row-hover {
  background: rgba(255, 255, 255, 0.32);
}

.download-cover {
  position: relative;
  width: 116rpx;
  height: 152rpx;
  flex: none;
  border-radius: 14rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 10rpx;
}

.download-format {
  position: relative;
  z-index: 2;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  font-size: 17rpx;
  letter-spacing: 1rpx;
  color: #ffffff;
  background: rgba(20, 24, 32, 0.36);
  -webkit-backdrop-filter: blur(12rpx);
  backdrop-filter: blur(12rpx);
}

.download-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.download-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.download-meta {
  font-size: 21rpx;
  color: var(--ink-3);
}

.download-time {
  font-size: 20rpx;
  color: var(--ink-3);
}

.downloads-empty {
  margin-top: 70rpx;
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border-radius: 30rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 34rpx rgba(31, 58, 100, 0.08);
}

.downloads-empty-title {
  font-size: 31rpx;
  font-weight: 700;
}

.downloads-empty-sub {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-3);
}

.downloads-empty-btn {
  width: 240rpx;
  margin-top: 34rpx;
}

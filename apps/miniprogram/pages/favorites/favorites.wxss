.favorites-tip {
  margin-top: 80rpx;
  text-align: center;
  font-size: 25rpx;
  color: var(--ink-3);
}

.favorites-empty {
  margin-top: 80rpx;
  padding: 70rpx 40rpx;
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.favorites-empty-title {
  font-size: 32rpx;
  font-weight: 700;
}

.favorites-empty-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.7;
}

.favorites-empty-btn {
  margin-top: 32rpx;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #fff;
  background: var(--brand);
  border: none;
}

.favorites-empty-btn::after {
  border: none;
}

.fav-remove {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  z-index: 3;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.95);
  background: rgba(0, 0, 0, 0.24);
}

.card {
  position: relative;
}

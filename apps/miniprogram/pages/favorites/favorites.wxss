.favorites-tip {
  margin-top: 80rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}

.favorites-empty {
  margin-top: 70rpx;
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
}

.favorites-empty-title {
  font-size: 31rpx;
  font-weight: 700;
}

.favorites-empty-sub {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-3);
}

.favorites-empty-btn {
  width: 240rpx;
  margin-top: 34rpx;
}

.card {
  position: relative;
}

.fav-remove {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  z-index: 3;
  padding: 5rpx 12rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  color: var(--ink-2);
  background: rgba(255, 255, 255, 0.92);
}

.favorites-tip {
  margin-top: 80rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
}

.favorites-empty {
  margin-top: 70rpx;
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: var(--glass);
  -webkit-backdrop-filter: blur(28rpx) saturate(180%);
  backdrop-filter: blur(28rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  border-radius: 30rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 34rpx rgba(31, 58, 100, 0.08);
}

.favorites-empty-title {
  font-size: 31rpx;
  font-weight: 700;
}

.favorites-empty-sub {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-3);
}

.favorites-empty-btn {
  width: 240rpx;
  margin-top: 34rpx;
}

<view class="nav" style="padding-top: {{navTop}}px;">
  <view class="nav-inner" style="margin-right: {{menuRight}}px;">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="brand">我的收藏</text>
    <text class="brand-sub">{{items.length}} 个</text>
  </view>
</view>

<view class="page" style="padding-top: {{contentTop}}px;">
  <view wx:if="{{loading}}" class="favorites-tip">加载中…</view>

  <block wx:elif="{{items.length}}">
    <view class="grid">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="card"
        data-id="{{item.id}}"
        bindtap="openDetail"
        hover-class="card-hover"
      >
        <view class="cover tone-{{item.tone}}">
          <image wx:if="{{item.coverUrl}}" class="cover-img" src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
          <text class="cover-format">{{item.format}}</text>
          <text wx:if="{{!item.coverUrl}}" class="cover-title">{{item.title}}</text>
        </view>
        <view class="card-body">
          <text class="card-title">{{item.title}}</text>
          <view class="card-meta">
            <text>{{item.category}}</text>
            <text>{{item.pageCount}} 页</text>
          </view>
        </view>
        <view class="fav-remove" catchtap="removeFav" data-id="{{item.id}}">移除</view>
      </view>
    </view>
  </block>

  <view wx:else class="favorites-empty">
    <text class="favorites-empty-title">还没有收藏的模板</text>
    <text class="favorites-empty-sub">在详情页点「收藏」，模板会同步到这里</text>
    <button class="btn-dark favorites-empty-btn" bindtap="goHome">去逛逛</button>
  </view>

  <view class="tabbar-pad"></view>
</view>

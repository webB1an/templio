.search-page {
  padding-bottom: 80rpx;
}

.search-field {
  flex: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 20rpx;
  margin-left: 8rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(28rpx) saturate(180%);
  backdrop-filter: blur(28rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  border-radius: 999rpx;
}

.search-field .search-icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
  flex: none;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.search-placeholder {
  color: var(--ink-3);
  font-size: 26rpx;
}

.clear-btn {
  width: 38rpx;
  height: 38rpx;
  flex: none;
  margin-left: 10rpx;
  border-radius: 50%;
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
  color: var(--ink-3);
  background: rgba(120, 130, 150, 0.14);
}

.search-intro {
  margin-top: 10rpx;
  padding: 26rpx 28rpx;
  border-radius: 30rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 34rpx rgba(31, 58, 100, 0.08);
}

.search-intro-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
}

.search-intro-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-3);
}

.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 38rpx 4rpx 16rpx;
}

.block-title {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
}

.block-clear {
  font-size: 21rpx;
  color: var(--ink-3);
}

.keyword-chips {
  display: flex;
  flex-wrap: wrap;
}

.keyword-chip {
  display: inline-flex;
  align-items: center;
  height: 76rpx;
  padding: 0 30rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: var(--ink);
  background: var(--glass);
  -webkit-backdrop-filter: blur(24rpx) saturate(170%);
  backdrop-filter: blur(24rpx) saturate(170%);
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
}

.keyword-chip-hover {
  background: rgba(255, 255, 255, 0.8);
}

.history-chip {
  color: var(--ink-2);
  background: rgba(255, 255, 255, 0.45);
}

.search-tip {
  margin-top: 26rpx;
  padding: 0 4rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ink-3);
}

.result-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 26rpx 4rpx 24rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 700;
}

.result-count {
  font-size: 22rpx;
  color: var(--ink-3);
}

.empty {
  margin: 20rpx 0;
}

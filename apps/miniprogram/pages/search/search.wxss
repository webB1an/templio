.search-page {
  padding-bottom: 80rpx;
}

.search-field {
  flex: 1;
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 18rpx;
  margin-left: 8rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
}

.search-field .search-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
  color: var(--ink-3);
}

.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.search-placeholder {
  color: var(--ink-3);
  font-size: 26rpx;
}

.clear-btn {
  width: 38rpx;
  height: 38rpx;
  flex: none;
  margin-left: 10rpx;
  border-radius: 50%;
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
  color: var(--ink-3);
  background: var(--paper-2);
}

.block-title {
  display: block;
  margin: 36rpx 0 16rpx;
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 44rpx;
}

.block-head .block-title {
  margin: 0 0 16rpx;
}

.block-clear {
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.keyword-list {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}

.keyword-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid var(--line);
}

.keyword-row:last-child {
  border-bottom: none;
}

.keyword-hover {
  background: #faf8f4;
}

.keyword-text {
  font-size: 27rpx;
  color: var(--ink);
}

.keyword-arrow {
  font-size: 24rpx;
  color: var(--ink-3);
}

.search-tip {
  margin-top: 56rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-3);
}

.result-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 24rpx 0 24rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 700;
}

.result-count {
  font-size: 22rpx;
  color: var(--ink-3);
}

.empty {
  margin: 20rpx 0;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
}

<view class="nav" style="padding-top: {{navTop}}px;">
  <view class="nav-inner" style="margin-right: {{menuRight}}px;">
    <view class="nav-back" bindtap="onCancel">‹</view>
    <view class="search-field">
      <text class="search-icon">⌕</text>
      <input
        class="search-input"
        value="{{inputValue}}"
        focus="{{autoFocus}}"
        placeholder="搜索模板、场景或风格"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="onConfirm"
      />
      <view wx:if="{{inputValue}}" class="clear-btn" bindtap="onClearInput">×</view>
    </view>
  </view>
</view>

<view class="page search-page" style="padding-top: {{contentTop}}px;">
  <block wx:if="{{!hasSearched}}">
    <text class="block-title">热门搜索</text>
    <view class="keyword-list">
      <view
        wx:for="{{hotKeywords}}"
        wx:key="*this"
        class="keyword-row"
        data-keyword="{{item}}"
        bindtap="onHotTap"
        hover-class="keyword-hover"
      >
        <text class="keyword-text">{{item}}</text>
        <text class="keyword-arrow">→</text>
      </view>
    </view>

    <block wx:if="{{history.length}}">
      <view class="block-head">
        <text class="block-title">搜索历史</text>
        <text class="block-clear" bindtap="onClearHistory">清空</text>
      </view>
      <view class="keyword-list">
        <view
          wx:for="{{history}}"
          wx:key="*this"
          class="keyword-row"
          data-keyword="{{item}}"
          bindtap="onHistoryTap"
          hover-class="keyword-hover"
        >
          <text class="keyword-text">{{item}}</text>
          <text class="keyword-arrow">→</text>
        </view>
      </view>
    </block>

    <view wx:if="{{!history.length}}" class="search-tip">
      输入关键词开始搜索，例如「答辩」「简历」「合同」
    </view>
  </block>

  <block wx:else>
    <view class="result-head">
      <text class="result-title">搜索结果</text>
      <text class="result-count">{{results.length}} 个模板</text>
    </view>

    <view wx:if="{{!loading && results.length === 0}}" class="empty">
      没有找到「{{keyword}}」相关模板，换个关键词试试
    </view>

    <view class="grid">
      <view
        wx:for="{{results}}"
        wx:key="id"
        class="card"
        data-id="{{item.id}}"
        bindtap="openDetail"
        hover-class="card-hover"
      >
        <view class="cover tone-{{item.tone}}">
          <image wx:if="{{item.coverUrl}}" class="cover-img" src="{{item.coverUrl}}" mode="aspectFill" lazy-load binderror="onCoverError" data-index="{{index}}" />
          <text class="cover-format">{{item.format}}</text>
          <text wx:if="{{!item.coverUrl}}" class="cover-title">{{item.title}}</text>
        </view>
        <view class="card-body">
          <text class="card-title">{{item.title}}</text>
          <view class="card-meta">
            <text>{{item.category}}</text>
            <text>{{item.pageCount}} 页</text>
          </view>
        </view>
      </view>
    </view>

    <view class="list-tip" wx:if="{{loading}}">加载中…</view>
    <view class="list-tip" wx:if="{{!loading && !hasMore && results.length}}">已经到底了</view>
  </block>

  <view class="tabbar-pad"></view>
</view>

<view class="nav" style="padding-top: {{navTop}}px;">
  <view class="nav-inner" style="margin-right: {{menuRight}}px;">
    <view class="nav-back" bindtap="onCancel"><view class="chevron chevron-left"></view></view>
    <view class="search-field">
      <image class="search-icon" src="/assets/icons/search.png" mode="aspectFit" />
      <input
        class="search-input"
        value="{{inputValue}}"
        focus="{{autoFocus}}"
        placeholder="搜索模板、场景或风格"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onInput"
        bindconfirm="onConfirm"
      />
      <view wx:if="{{inputValue}}" class="clear-btn" bindtap="onClearInput">×</view>
    </view>
  </view>
</view>

<view class="page search-page" style="padding-top: {{contentTop}}px;">
  <block wx:if="{{!hasSearched}}">
    <view class="search-intro">
      <text class="search-intro-title">搜索模板</text>
      <text class="search-intro-sub">输入场景、格式或关键词，快速找到可用模板</text>
    </view>

    <view class="block-head">
      <text class="block-title">热门搜索</text>
    </view>
    <view class="keyword-chips">
      <view
        wx:for="{{hotKeywords}}"
        wx:key="*this"
        class="keyword-chip"
        data-keyword="{{item}}"
        bindtap="onHotTap"
        hover-class="keyword-chip-hover"
      >{{item}}</view>
    </view>

    <block wx:if="{{history.length}}">
      <view class="block-head">
        <text class="block-title">搜索历史</text>
        <text class="block-clear" bindtap="onClearHistory">清空</text>
      </view>
      <view class="keyword-chips">
        <view
          wx:for="{{history}}"
          wx:key="*this"
          class="keyword-chip history-chip"
          data-keyword="{{item}}"
          bindtap="onHistoryTap"
          hover-class="keyword-chip-hover"
        >{{item}}</view>
      </view>
    </block>

    <view wx:if="{{!history.length}}" class="search-tip">
      输入关键词开始搜索，例如「答辩」「简历」「合同」
    </view>

    <block wx:if="{{recommend.length}}">
      <view class="section-head">
        <text class="section-title">推荐模板</text>
        <view class="section-more" bindtap="goHome">
          <text>去首页</text>
          <view class="chevron chevron-right"></view>
        </view>
      </view>
      <view class="grid">
        <view class="grid-item" wx:for="{{recommend}}" wx:key="id">
          <template-card item="{{item}}" bind:open="onOpenCard" />
        </view>
      </view>
    </block>
  </block>

  <block wx:else>
    <view class="result-head">
      <text class="result-title">搜索结果</text>
      <text class="result-count">{{results.length}} 个模板</text>
    </view>

    <view wx:if="{{!loading && results.length === 0}}" class="empty">
      没有找到「{{keyword}}」相关模板，换个关键词试试
    </view>

    <view class="grid">
      <view class="grid-item" wx:for="{{results}}" wx:key="id">
        <template-card item="{{item}}" bind:open="onOpenCard" />
      </view>
    </view>

    <view class="list-tip" wx:if="{{loading}}">加载中…</view>
    <view class="list-tip" wx:if="{{!loading && !hasMore && results.length}}">已经到底了</view>
  </block>

  <view class="tabbar-pad"></view>
</view>

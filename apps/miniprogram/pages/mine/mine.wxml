<view class="nav" style="padding-top: {{navTop}}px;">
  <view class="nav-inner" style="margin-right: {{menuRight}}px;">
    <text class="brand">我的</text>
    <text class="brand-sub">账户</text>
  </view>
</view>

<view class="page" style="padding-top: {{contentTop}}px;">
  <view class="account-card">
    <view class="profile-row">
      <view class="avatar">T</view>
      <view class="profile-main">
        <text class="profile-name">{{userName}}</text>
        <text class="profile-sub">{{userSub}}</text>
      </view>
    </view>

    <view class="stats">
      <view class="stat">
        <text class="stat-num">{{favCount}}</text>
        <text class="stat-label">收藏</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{downloadCount}}</text>
        <text class="stat-label">下载</text>
      </view>
      <view class="stat">
        <text class="stat-num">0</text>
        <text class="stat-label">浏览</text>
      </view>
    </view>
  </view>

  <text class="section-label">账户与设置</text>

  <view class="menu">
    <view
      wx:for="{{menu}}"
      wx:key="key"
      class="menu-row"
      data-key="{{item.key}}"
      bindtap="onMenu"
      hover-class="menu-row-hover"
    >
      <text class="menu-label">{{item.label}}</text>
      <text class="menu-tip">{{item.tip}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="footer-tip">模板宝 · 模板仅供学习交流，版权归原作者</view>
  <view class="tabbar-pad"></view>
</view>

.account-card {
  margin-top: 8rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}

.profile-row {
  display: flex;
  align-items: center;
  padding: 34rpx 28rpx 30rpx;
}

.avatar {
  width: 94rpx;
  height: 94rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  background: var(--accent);
}

.profile-main {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.profile-name {
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: -0.3rpx;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--ink-3);
}

.stats {
  display: flex;
  border-top: 1rpx solid var(--line);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 0 28rpx;
}

.stat + .stat {
  border-left: 1rpx solid var(--line);
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.section-label {
  display: block;
  margin: 42rpx 0 16rpx 4rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

.menu {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}

.menu-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid var(--line);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-row-hover {
  background: #faf8f4;
}

.menu-label {
  flex: 1;
  font-size: 27rpx;
  font-weight: 500;
}

.menu-tip {
  margin-right: 12rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.menu-arrow {
  font-size: 30rpx;
  color: var(--ink-3);
}

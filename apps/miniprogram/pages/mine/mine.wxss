.profile {
  display: flex;
  align-items: center;
  padding: 40rpx 34rpx;
  margin-top: 8rpx;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #2f6be4 0%, #8b7bff 100%);
  box-shadow: 0 12rpx 26rpx rgba(47, 107, 228, 0.28);
}

.profile-main {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 700;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.stats {
  display: flex;
  margin-top: 22rpx;
  padding: 30rpx 0;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat + .stat {
  border-left: 1rpx solid rgba(31, 58, 147, 0.08);
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.menu {
  margin-top: 22rpx;
  padding: 8rpx 34rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  height: 104rpx;
  border-bottom: 1rpx solid rgba(31, 58, 147, 0.06);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 56rpx;
  font-size: 30rpx;
  color: var(--brand);
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
}

.menu-tip {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-right: 12rpx;
}

.menu-arrow {
  font-size: 30rpx;
  color: var(--ink-3);
}

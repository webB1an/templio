.account-card {
  margin-top: 8rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(32rpx) saturate(180%);
  backdrop-filter: blur(32rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95), 0 16rpx 38rpx rgba(31, 58, 100, 0.1);
}

.profile-row {
  display: flex;
  align-items: center;
  padding: 34rpx 28rpx 30rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #0a84ff 0%, #6aa9ff 100%);
  box-shadow: 0 10rpx 24rpx rgba(10, 132, 255, 0.26);
}

.profile-main {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.profile-name {
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: -0.3rpx;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--ink-3);
}

.stats {
  display: flex;
  border-top: 1rpx solid var(--line);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 0 28rpx;
}

.stat + .stat {
  border-left: 1rpx solid var(--line);
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.section-label {
  display: block;
  margin: 40rpx 4rpx 16rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

.menu {
  overflow: hidden;
  border-radius: 30rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 34rpx rgba(31, 58, 100, 0.08);
}

.menu-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid var(--line);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-row-hover {
  background: rgba(255, 255, 255, 0.32);
}

.menu-label {
  flex: 1;
  font-size: 27rpx;
  font-weight: 500;
}

.menu-tip {
  margin-right: 12rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.menu-arrow {
  font-size: 30rpx;
  color: var(--ink-3);
}

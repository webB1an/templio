<view class="tabbar">
  <view class="tabbar-inner">
    <view
      wx:for="{{tabs}}"
      wx:key="pagePath"
      class="tab {{selected === index ? 'tab-active' : ''}}"
      data-index="{{index}}"
      bindtap="onTap"
    >
      <text class="tab-icon">{{item.icon}}</text>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>

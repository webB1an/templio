.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: var(--surface, #ffffff);
  border-top: 1rpx solid var(--line, #e7e4de);
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar-inner {
  display: flex;
  align-items: stretch;
  height: 104rpx;
}

.tab {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--ink-3, #96999e);
}

.tab-active {
  color: var(--ink, #191b1e);
}

.tab-active::before {
  content: "";
  position: absolute;
  top: 0;
  width: 44rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--accent, #b0472a);
}

.tab-text {
  font-size: 23rpx;
  line-height: 1;
  letter-spacing: 1rpx;
}

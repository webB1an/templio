.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: rgba(255, 255, 255, 0.56);
  -webkit-backdrop-filter: blur(32rpx) saturate(180%);
  backdrop-filter: blur(32rpx) saturate(180%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.72);
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar-inner {
  display: flex;
  align-items: stretch;
  height: 108rpx;
}

.tab {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8e8e93;
}

.tab-active {
  color: #1c1c1e;
}

.tab-active::before {
  content: "";
  position: absolute;
  top: 0;
  width: 44rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #0a84ff;
}

.tab-text {
  font-size: 23rpx;
  line-height: 1;
  letter-spacing: 1rpx;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 0 32rpx calc(18rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tabbar-inner {
  display: flex;
  align-items: center;
  height: 108rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.66);
  -webkit-backdrop-filter: blur(26rpx) saturate(170%);
  backdrop-filter: blur(26rpx) saturate(170%);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 44rpx rgba(31, 58, 147, 0.16);
  pointer-events: auto;
}

.tab {
  flex: 1;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #8a90a6;
}

.tab-active {
  color: #2f6be4;
  background: rgba(47, 107, 228, 0.1);
}

.tab-icon {
  font-size: 32rpx;
  line-height: 1;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1;
}

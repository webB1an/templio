.page {
  padding-bottom: 32rpx;
}

/* ── 余额玻璃大卡：品牌渐层 + 顶部高光（§11.2 高光集中在积分余额卡） ── */
.hero {
  position: relative;
  overflow: hidden;
  margin: 24rpx;
  padding: 44rpx 36rpx 40rpx;
  border-radius: 32rpx;
  background: linear-gradient(160deg, #1747de 0%, #245bff 55%, #4d8dff 90%, #55d8f2 130%);
  box-shadow:
    0 12rpx 40rpx rgba(36, 91, 255, 0.25),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.25);
  color: #fff;
  text-align: center;
}

.hero::before {
  content: '';
  position: absolute;
  top: -100rpx;
  left: -60rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(85, 216, 242, 0.32) 0%, rgba(85, 216, 242, 0) 70%);
}

.balance-label {
  position: relative;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 星光金：积分数字点缀色（§11.1 星光金仅点缀） */
.balance {
  position: relative;
  font-size: 84rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #ffd86b;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.18);
  margin: 8rpx 0 4rpx;
}

.hero-tip {
  position: relative;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  margin-bottom: 24rpx;
}

.checkin-btn {
  position: relative;
  display: inline-block;
  font-size: 26rpx;
  font-weight: 600;
  color: #245bff;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  padding: 0 48rpx;
  height: 76rpx;
  line-height: 76rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
}

.checkin-btn::after {
  border: none;
}

.checkin-btn.done {
  color: #0a8a6d;
  background: rgba(53, 214, 182, 0.9);
  color: #fff;
}

/* ── 卡片 ── */
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #17233f;
  margin-bottom: 20rpx;
}

/* ── 充值 SKU ── */
.sku-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.sku {
  position: relative;
  text-align: center;
  padding: 28rpx 8rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 2rpx solid rgba(36, 91, 255, 0.12);
  overflow: hidden;
}

.sku-hover,
.sku.paying {
  border-color: #245bff;
  background: rgba(36, 91, 255, 0.06);
}

.sku-badge {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 18rpx;
  color: #6b4a00;
  background: linear-gradient(135deg, #ffd86b, #ffb93d);
  border-radius: 0 20rpx 0 16rpx;
  padding: 4rpx 14rpx;
  font-weight: 600;
}

.sku-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #17233f;
}

.sku-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #697995;
}

.sku-price {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #245bff;
}

.sku-note {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #b8860b;
}

/* ── 积分明细 ── */
.ledger-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(36, 91, 255, 0.08);
}

.ledger-row:last-child {
  border-bottom: none;
}

.ledger-type {
  font-size: 26rpx;
  font-weight: 600;
  color: #17233f;
}

.ledger-reason,
.ledger-time {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #697995;
}

.ledger-right {
  text-align: right;
}

.ledger-amount {
  font-size: 30rpx;
  font-weight: 700;
}

.ledger-amount.plus {
  color: #0a8a6d;
}

.ledger-amount.minus {
  color: #d0433a;
}

.ledger-balance {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #697995;
}

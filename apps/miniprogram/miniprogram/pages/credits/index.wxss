.page {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2233;
  margin-bottom: 24rpx;
}

.hero {
  background: linear-gradient(135deg, #245bff 0%, #4f7dff 100%);
  color: #fff;
  text-align: center;
  padding: 48rpx 32rpx;
}

.balance-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.balance {
  font-size: 72rpx;
  font-weight: 700;
  margin: 12rpx 0 24rpx;
}

.checkin-btn {
  background: #fff;
  color: #245bff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 0 48rpx;
  line-height: 72rpx;
  height: 72rpx;
}

.checkin-btn.done {
  opacity: 0.6;
}

.sku-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.sku {
  position: relative;
  border: 2rpx solid #e8efff;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}

.sku.paying {
  opacity: 0.6;
}

.sku-badge {
  position: absolute;
  top: -14rpx;
  right: 12rpx;
  background: #ff8f1f;
  color: #fff;
  font-size: 18rpx;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.sku-total {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2233;
}

.sku-price {
  font-size: 24rpx;
  color: #245bff;
  margin-top: 8rpx;
}

.sku-note {
  font-size: 20rpx;
  color: #0aa870;
  margin-top: 4rpx;
}

.ledger-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f3fa;
}

.ledger-row:last-child {
  border-bottom: none;
}

.ledger-type {
  font-size: 26rpx;
  color: #1a2233;
}

.ledger-reason {
  font-size: 22rpx;
  color: #9aa7bd;
  margin-top: 4rpx;
}

.ledger-time {
  font-size: 20rpx;
  color: #c0c9d9;
  margin-top: 4rpx;
}

.ledger-right {
  text-align: right;
}

.ledger-amount {
  font-size: 28rpx;
  font-weight: 600;
}

.ledger-amount.plus {
  color: #0aa870;
}

.ledger-amount.minus {
  color: #e0564b;
}

.ledger-balance {
  font-size: 20rpx;
  color: #9aa7bd;
  margin-top: 4rpx;
}

.empty {
  text-align: center;
  color: #9aa7bd;
  font-size: 24rpx;
  padding: 40rpx 0;
}

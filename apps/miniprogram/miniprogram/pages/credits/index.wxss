.page {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.hero {
  background: linear-gradient(135deg, #245bff 0%, #4f7dff 100%);
  color: #fff;
  text-align: center;
  padding: 48rpx 32rpx;
}

.balance-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.balance {
  font-size: 72rpx;
  font-weight: 700;
  margin: 12rpx 0;
}

.hint {
  font-size: 22rpx;
  opacity: 0.75;
}

.p-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2233;
  margin-bottom: 16rpx;
}

.p-item {
  font-size: 26rpx;
  color: #697995;
  line-height: 2;
}

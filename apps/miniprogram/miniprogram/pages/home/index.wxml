<view class="page">
  <!-- 品牌头部：蓝色渐层 + 玻璃搜索胶囊（PRD §11.2 高光集中在头部） -->
  <view class="hero">
    <view class="hero-title">万用模板</view>
    <view class="hero-sub">办公 · 学习 · 生活，一键找模板</view>
    <view class="search-capsule" bindtap="goSearchPage">
      <text class="search-icon">🔍</text>
      <input
        placeholder="搜索模板，如：年终汇报"
        placeholder-class="search-ph"
        confirm-type="search"
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
    </view>
    <view class="hero-stats" wx:if="{{totalTemplates}}">
      <text>已收录 {{totalTemplates}} 个模板</text>
    </view>
  </view>

  <swiper
    wx:if="{{banners.length}}"
    class="banners"
    autoplay
    circular
    indicator-dots
    indicator-color="rgba(255,255,255,0.45)"
    indicator-active-color="#FFFFFF"
    interval="4000"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image class="banner-img" src="{{item.image}}" mode="aspectFill" data-item="{{item}}" bindtap="onBannerTap" />
    </swiper-item>
  </swiper>

  <view class="hot-words" wx:if="{{hotKeywords.length}}">
    <text class="hot-label">🔥 大家都在搜</text>
    <view class="hot-word" wx:for="{{hotKeywords}}" wx:key="*this" data-keyword="{{item}}" bindtap="onHotKeywordTap">{{item}}</view>
  </view>

  <view class="section" wx:if="{{hot.length}}">
    <view class="section-title"><text class="section-mark"></text>热门模板</view>
    <view class="grid">
      <template-card wx:for="{{hot}}" wx:key="id" item="{{item}}" />
    </view>
  </view>

  <view class="section" wx:if="{{latest.length}}">
    <view class="section-title"><text class="section-mark"></text>最新上架</view>
    <view class="grid">
      <template-card wx:for="{{latest}}" wx:key="id" item="{{item}}" />
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
</view>

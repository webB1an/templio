.page {
  padding-bottom: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── 品牌头部：蓝色渐层 + 顶部高光 + 玻璃搜索胶囊 ── */
.hero {
  position: relative;
  background: linear-gradient(160deg, #1747de 0%, #245bff 55%, #4d8dff 85%, #55d8f2 120%);
  border-radius: 0 0 40rpx 40rpx;
  padding: 48rpx 32rpx 56rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(36, 91, 255, 0.22);
}

/* 顶部内侧高光（玻璃景深层次） */
.hero::before {
  content: '';
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(85, 216, 242, 0.35) 0%, rgba(85, 216, 242, 0) 70%);
}

.hero-title {
  position: relative;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.hero-sub {
  position: relative;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.search-capsule {
  position: relative;
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  /* 玻璃层 + 降级：半透明白底在深色渐层上仍可读 */
  background: rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
}

.search-icon {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.search-capsule input {
  flex: 1;
  font-size: 26rpx;
  color: #fff;
  min-height: 44rpx;
}

.search-ph {
  color: rgba(255, 255, 255, 0.6);
}

.hero-stats {
  position: relative;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* ── 轮播 Banner ── */
.banners {
  height: 280rpx;
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(36, 91, 255, 0.12);
}

.banner-img {
  width: 100%;
  height: 280rpx;
}

/* ── 热门关键词胶囊 ── */
.hot-words {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin: 4rpx 24rpx 28rpx;
  font-size: 24rpx;
}

.hot-label {
  color: #697995;
}

.hot-word {
  color: #245bff;
  background: rgba(36, 91, 255, 0.08);
  border: 1rpx solid rgba(36, 91, 255, 0.16);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

/* ── 楼层 ── */
.section {
  margin: 0 24rpx 36rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #17233f;
  margin-bottom: 20rpx;
}

.section-mark {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #4d8dff, #245bff);
  margin-right: 14rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

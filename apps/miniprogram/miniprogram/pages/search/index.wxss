.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── 玻璃搜索胶囊 ── */
.search-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 999rpx;
  padding: 16rpx 24rpx 16rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(36, 91, 255, 0.1), inset 0 2rpx 0 rgba(255, 255, 255, 0.8);
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
  color: #17233f;
  min-height: 48rpx;
}

.clear {
  font-size: 24rpx;
  color: #697995;
  padding: 8rpx;
}

.go {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #4d8dff, #245bff);
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(36, 91, 255, 0.3);
}

/* ── 结果统计 ── */
.result-bar {
  margin: 28rpx 4rpx 20rpx;
  font-size: 24rpx;
  color: #697995;
}

/* ── 结果网格 ── */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

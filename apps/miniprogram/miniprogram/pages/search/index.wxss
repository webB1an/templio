.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.search-input {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 10rpx 12rpx 10rpx 28rpx;
  margin-bottom: 24rpx;
}

.search-input input {
  flex: 1;
  font-size: 26rpx;
}

.clear {
  color: #9aa7bd;
  padding: 0 8rpx;
}

.go {
  background: #245bff;
  color: #fff;
  font-size: 24rpx;
  border-radius: 28rpx;
  padding: 12rpx 32rpx;
}

.result-bar {
  font-size: 24rpx;
  color: #697995;
  margin-bottom: 20rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.loading,
.empty {
  text-align: center;
  color: #697995;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.error {
  text-align: center;
  color: #e0564b;
  font-size: 26rpx;
  padding: 40rpx 0;
}

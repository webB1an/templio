<view class="page">
  <view class="search-input">
    <input focus placeholder="输入关键词搜索模板" value="{{keyword}}" bindinput="onInput" bindconfirm="onConfirm" confirm-type="search" />
    <text wx:if="{{keyword}}" class="clear" bindtap="onClear">✕</text>
    <view class="go" bindtap="onConfirm">搜索</view>
  </view>

  <view class="result-bar" wx:if="{{searched}}">找到 {{total}} 个相关模板</view>
  <view class="grid">
    <template-card wx:for="{{items}}" wx:key="id" item="{{item}}" />
  </view>
  <view wx:if="{{loading}}" class="loading">搜索中…</view>
  <view wx:if="{{searched && !loading && !items.length}}" class="empty">没有找到相关模板，换个关键词试试</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>

.page {
  padding-bottom: 32rpx;
}

.card-hover {
  opacity: 0.88;
}

/* ── 用户卡 ── */
.user {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4d8dff, #245bff);
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(36, 91, 255, 0.3);
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #17233f;
}

.user-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #697995;
}

.login-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #4d8dff, #245bff);
  border-radius: 999rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 32rpx;
}

.login-btn::after {
  border: none;
}

/* ── 积分余额入口 ── */
.balance-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.balance-label {
  font-size: 24rpx;
  color: #697995;
}

.balance-num {
  margin-top: 4rpx;
  font-size: 48rpx;
  font-weight: 800;
  color: #b8860b;
}

.balance-arrow {
  font-size: 24rpx;
  color: #245bff;
  font-weight: 600;
}

/* ── 菜单 ── */
.menu {
  padding: 8rpx 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #17233f;
  border-bottom: 1rpx solid rgba(36, 91, 255, 0.08);
  background: transparent;
  text-align: left;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item::after {
  border: none;
}

.menu-item.disabled {
  color: #697995;
}

.menu-icon {
  font-size: 30rpx;
}

.menu-text {
  flex: 1;
}

.menu-arrow {
  color: #245bff;
  font-size: 32rpx;
}

.share-entry {
  line-height: 1.4;
  padding-left: 0;
  padding-right: 0;
  border-radius: 0;
  font-weight: 400;
}

/* ── 底部 ── */
.about {
  text-align: center;
  font-size: 22rpx;
  color: #697995;
  padding: 40rpx 0 20rpx;
}

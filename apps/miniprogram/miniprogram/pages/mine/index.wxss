.page {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.user {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #245bff;
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a2233;
}

.user-sub {
  font-size: 22rpx;
  color: #9aa7bd;
  margin-top: 8rpx;
}

.menu {
  padding: 8rpx 32rpx;
}

.menu-item {
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #1a2233;
  border-bottom: 1rpx solid #f0f3fa;
}

.menu-item:last-child {
  border-bottom: none;
}

.about {
  text-align: center;
  font-size: 22rpx;
  color: #9aa7bd;
  padding: 40rpx 0;
}

.page {
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

.slides,
.single-cover {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.slide {
  width: 100%;
  height: 420rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2233;
  margin-bottom: 16rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a2233;
  line-height: 1.4;
}

.summary {
  font-size: 26rpx;
  color: #697995;
  margin-top: 12rpx;
  line-height: 1.6;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.tag {
  font-size: 22rpx;
  color: #697995;
  background: #f0f3fa;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
}

.price {
  font-size: 26rpx;
  font-weight: 700;
  color: #245bff;
}

.views {
  font-size: 22rpx;
  color: #9aa7bd;
  margin-left: auto;
}

.file-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f3fa;
  font-size: 24rpx;
}

.file-row:last-child {
  border-bottom: none;
}

.file-name {
  color: #1a2233;
  flex: 1;
  word-break: break-all;
}

.file-meta {
  color: #9aa7bd;
  margin-left: 16rpx;
  white-space: nowrap;
}

.link-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}

.link-text {
  flex: 1;
  font-size: 24rpx;
  color: #245bff;
  word-break: break-all;
}

.copy-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #fff;
  background: #245bff;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
}

.link-tip {
  font-size: 22rpx;
  color: #9aa7bd;
  margin-top: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2233;
  margin-bottom: 20rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(26, 34, 51, 0.06);
}

.claim-btn {
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #fff;
  border: none;
}

.claim-btn.free {
  background: #245bff;
}

.claim-btn.paid {
  background: #ff8f1f;
}

.loading,
.error {
  text-align: center;
  color: #697995;
  font-size: 26rpx;
  padding: 120rpx 0;
}

.error {
  color: #e0564b;
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── 维度切换胶囊条（吸顶） ── */
.dim-tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 16rpx 4rpx 20rpx;
  margin: -24rpx -24rpx 12rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  background: rgba(244, 247, 255, 0.88);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.dim-tab {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #697995;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(36, 91, 255, 0.06);
}

.dim-tab.active {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #4d8dff, #245bff);
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(36, 91, 255, 0.3);
}

/* ── 分类分组 ── */
.cat-group {
  margin-bottom: 20rpx;
}

.group-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #17233f;
  margin-bottom: 16rpx;
}

.group-cats {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cat-chip {
  font-size: 24rpx;
  color: #17233f;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(36, 91, 255, 0.12);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
}

.cat-chip.active {
  color: #245bff;
  font-weight: 600;
  background: rgba(36, 91, 255, 0.1);
  border-color: #245bff;
}

/* ── 排序条 ── */
.sort-bar {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 20rpx 4rpx;
  font-size: 26rpx;
  position: sticky;
  top: 96rpx;
  z-index: 9;
  background: rgba(244, 247, 255, 0.88);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.sort-item {
  color: #697995;
}

.sort-item.active {
  color: #245bff;
  font-weight: 700;
}

.count {
  margin-left: auto;
  font-size: 22rpx;
  color: #697995;
}

/* ── 结果网格 ── */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

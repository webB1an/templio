.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.dim-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.dim-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  background: #fff;
  color: #697995;
  font-size: 26rpx;
}

.dim-tab.active {
  background: #245bff;
  color: #fff;
  font-weight: 600;
}

.cat-groups {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 24rpx;
}

.cat-group {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f3fa;
}

.cat-group:last-child {
  border-bottom: none;
}

.group-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a2233;
  margin-bottom: 12rpx;
}

.group-cats {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cat-chip {
  font-size: 24rpx;
  color: #697995;
  background: #f4f7ff;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
}

.cat-chip.active {
  background: #e8efff;
  color: #245bff;
  font-weight: 600;
}

.sort-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.sort-item {
  font-size: 26rpx;
  color: #697995;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.sort-item.active {
  color: #245bff;
  font-weight: 600;
}

.count {
  margin-left: auto;
  font-size: 22rpx;
  color: #9aa7bd;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.loading,
.empty {
  text-align: center;
  color: #697995;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.error {
  text-align: center;
  color: #e0564b;
  font-size: 26rpx;
  padding: 40rpx 0;
}

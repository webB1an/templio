/* 模板卡片：封面优先 + 玻璃外壳，价格角标用星光金点缀（PRD §11.2） */
.tpl-card {
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(36, 91, 255, 0.08);
}

.tpl-card-hover {
  transform: scale(0.98);
  opacity: 0.92;
}

.cover-wrap {
  position: relative;
}

.cover {
  width: 100%;
  height: 300rpx;
  background: linear-gradient(135deg, #eef3ff 0%, #e3ecff 100%);
  display: block;
}

/* 价格角标：付费 = 星光金玻璃，免费 = 薄荷绿（颜色 + 文字双重区分） */
.price-chip {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  color: #6b4a00;
  background: linear-gradient(135deg, rgba(255, 216, 107, 0.92), rgba(255, 185, 61, 0.92));
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  box-shadow: 0 4rpx 12rpx rgba(255, 185, 61, 0.35);
}

.price-chip.free {
  color: #fff;
  background: linear-gradient(135deg, #35d6b6, #1fbf9a);
  box-shadow: 0 4rpx 12rpx rgba(53, 214, 182, 0.35);
}

.info {
  padding: 20rpx 24rpx 24rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 600;
  color: #17233f;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 78rpx;
}

.meta {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.format {
  font-size: 22rpx;
  color: #245bff;
  background: rgba(36, 91, 255, 0.08);
  border: 1rpx solid rgba(36, 91, 255, 0.18);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.hot {
  font-size: 22rpx;
  color: #697995;
}

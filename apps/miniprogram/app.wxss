/* ============================================================
   模板宝小程序 · 全局样式
   液态玻璃（Liquid Glass）设计：玻璃仅用于「浮在内容之上的控制层」
   —— 导航、搜索条、筛选 chip、TabBar、详情信息卡、弹层。
   ============================================================ */

page {
  --ink: #1b2340;
  --ink-2: #5a6380;
  --ink-3: #8a90a6;
  --brand: #2f6be4;
  --brand-soft: rgba(47, 107, 228, 0.12);
  --glass-bg: rgba(255, 255, 255, 0.56);
  --glass-bg-strong: rgba(255, 255, 255, 0.74);
  --glass-border: rgba(255, 255, 255, 0.78);
  --glass-shadow: 0 12rpx 40rpx rgba(31, 58, 147, 0.12);
  --radius-lg: 40rpx;
  --radius-md: 28rpx;
  --radius-sm: 18rpx;

  min-height: 100vh;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei",
    "Helvetica Neue", sans-serif;
  background: linear-gradient(180deg, #edf2ff 0%, #f7f4ff 44%, #f1f7ff 100%);
  -webkit-font-smoothing: antialiased;
}

/* 背景光斑：让玻璃有内容可模糊 */
.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(70rpx);
  opacity: 0.55;
  z-index: 0;
  pointer-events: none;
}

.orb-a {
  width: 480rpx;
  height: 480rpx;
  left: -160rpx;
  top: -80rpx;
  background: radial-gradient(circle, #7aa7ff 0%, rgba(122, 167, 255, 0) 70%);
}

.orb-b {
  width: 520rpx;
  height: 520rpx;
  right: -200rpx;
  top: 420rpx;
  background: radial-gradient(circle, #ffb7dd 0%, rgba(255, 183, 221, 0) 70%);
}

.orb-c {
  width: 420rpx;
  height: 420rpx;
  left: 120rpx;
  bottom: -180rpx;
  background: radial-gradient(circle, #9ff0d8 0%, rgba(159, 240, 216, 0) 70%);
}

/* 页面内容需在光斑之上 */
.page {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 0 32rpx 200rpx;
  box-sizing: border-box;
}

/* ---------------- 玻璃基础 ---------------- */

.glass {
  background: var(--glass-bg);
  -webkit-backdrop-filter: blur(24rpx) saturate(160%);
  backdrop-filter: blur(24rpx) saturate(160%);
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), var(--glass-shadow);
  border-radius: var(--radius-md);
}

.glass-pill {
  border-radius: 999rpx;
}

.glass-strong {
  background: var(--glass-bg-strong);
}

/* ---------------- 自定义导航 ---------------- */

.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.nav-inner {
  height: 76rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}

.brand {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--ink);
}

.brand-sub {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.nav-back {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--ink);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

/* ---------------- 通用元素 ---------------- */

.hero-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.25;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.hero-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

.search {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 30rpx;
  margin-top: 36rpx;
  border-radius: 999rpx;
}

.search-icon {
  font-size: 34rpx;
  color: var(--ink-3);
  margin-right: 16rpx;
}

.search-text {
  font-size: 27rpx;
  color: var(--ink-3);
}

.chips {
  margin-top: 30rpx;
  white-space: nowrap;
  width: 100%;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 30rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}

.chip-active {
  color: #ffffff;
  background: linear-gradient(135deg, #2f6be4 0%, #6a8dff 100%);
  border-color: rgba(47, 107, 228, 0.6);
  box-shadow: 0 10rpx 24rpx rgba(47, 107, 228, 0.3);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 48rpx 0 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

.section-more {
  font-size: 25rpx;
  color: var(--brand);
}

/* ---------------- 模板卡片 ---------------- */

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  width: 48.6%;
  margin-bottom: 26rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 14rpx 36rpx rgba(31, 58, 147, 0.1);
}

.cover {
  position: relative;
  height: 420rpx;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.cover::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 46%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0));
}

.cover-format {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 2;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(0, 0, 0, 0.18);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.cover-title {
  position: relative;
  z-index: 2;
  color: #ffffff;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 600;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.22);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-body {
  padding: 22rpx 24rpx 26rpx;
}

.card-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 27rpx;
  line-height: 1.4;
  font-weight: 600;
}

.card-meta {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 封面配色（占位图，后续替换为真实预览图） */
.tone-blue {
  background: linear-gradient(145deg, #2563eb 0%, #60a5fa 55%, #bfdbfe 100%);
}
.tone-indigo {
  background: linear-gradient(145deg, #4338ca 0%, #818cf8 55%, #c7d2fe 100%);
}
.tone-green {
  background: linear-gradient(145deg, #047857 0%, #34d399 60%, #bbf7d0 100%);
}
.tone-orange {
  background: linear-gradient(145deg, #c2410c 0%, #fb923c 60%, #fed7aa 100%);
}
.tone-pink {
  background: linear-gradient(145deg, #be185d 0%, #f472b6 60%, #fbcfe8 100%);
}
.tone-slate {
  background: linear-gradient(145deg, #1e293b 0%, #64748b 60%, #cbd5e1 100%);
}
.tone-teal {
  background: linear-gradient(145deg, #0f766e 0%, #2dd4bf 60%, #ccfbf1 100%);
}
.tone-purple {
  background: linear-gradient(145deg, #6d28d9 0%, #a78bfa 60%, #ddd6fe 100%);
}

.footer-tip {
  margin-top: 48rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ---------------- 空态 / 骨架 ---------------- */

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
}

/* ---------------- TabBar 占位 ---------------- */

.tabbar-pad {
  height: 180rpx;
}

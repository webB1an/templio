/* ============================================================
   模板宝小程序 · 全局样式
   设计方向：纸感编辑风（Editorial）
   - 暖白纸面、墨色文字、陶土色强调
   - 细边框与留白代替玻璃、渐变和光斑
   ============================================================ */

page {
  --paper: #f6f5f2;
  --paper-2: #efede8;
  --surface: #ffffff;
  --ink: #191b1e;
  --ink-2: #5f6369;
  --ink-3: #96999e;
  --line: #e7e4de;
  --line-strong: #d8d4cc;
  --accent: #b0472a;
  --accent-ink: #8d371f;
  --accent-soft: #f4e8e2;
  --radius: 16rpx;
  --radius-sm: 10rpx;

  min-height: 100vh;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei",
    "Helvetica Neue", sans-serif;
  background: var(--paper);
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

/* 旧版光斑容器不再使用 */
.bg-orb {
  display: none !important;
}

/* ---------------- 页面骨架 ---------------- */

.page {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 0 36rpx 220rpx;
  box-sizing: border-box;
}

.hero {
  padding: 8rpx 0 0;
}

.eyebrow {
  display: block;
  margin-bottom: 18rpx;
  color: var(--accent);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.4;
}

.hero-title {
  display: block;
  font-size: 46rpx;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.hero-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--ink-2);
}

/* ---------------- 自定义导航 ---------------- */

.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  padding: 0 36rpx;
  box-sizing: border-box;
  background: rgba(246, 245, 242, 0.94);
  -webkit-backdrop-filter: blur(16rpx);
  backdrop-filter: blur(16rpx);
  border-bottom: 1rpx solid var(--line);
}

.nav-inner {
  height: 84rpx;
  display: flex;
  align-items: center;
}

/* 旧的玻璃导航 class 统一降级为透明 */
.nav .glass {
  background: transparent;
  border: none;
  box-shadow: none;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  border-radius: 0;
  padding: 0;
}

.brand {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  color: var(--ink);
}

.brand-sub {
  margin-left: 14rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  margin-left: -18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  font-size: 42rpx;
  line-height: 1;
  color: var(--ink);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.nav-placeholder {
  width: 64rpx;
  height: 64rpx;
}

/* ---------------- 通用表面 ---------------- */

/* 保留旧 .glass 名称，但视觉改为纸面卡片 */
.glass {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  box-shadow: none;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}

.glass-pill {
  border-radius: var(--radius);
}

/* ---------------- 搜索条 ---------------- */

.search {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 26rpx;
  margin-top: 34rpx;
  border-radius: var(--radius);
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.search-icon {
  margin-right: 14rpx;
  font-size: 30rpx;
  color: var(--ink-3);
}

.search-text {
  font-size: 26rpx;
  color: var(--ink-3);
}

/* ---------------- 分类文字标签 ---------------- */

.chips {
  margin-top: 30rpx;
  white-space: nowrap;
  width: 100%;
  border-bottom: 1rpx solid var(--line);
}

.chip {
  display: inline-block;
  height: auto;
  padding: 0 0 18rpx;
  margin-right: 34rpx;
  border-radius: 0;
  font-size: 26rpx;
  color: var(--ink-3);
  background: transparent;
  border: none;
  border-bottom: 3rpx solid transparent;
}

.chip-active {
  color: var(--ink);
  font-weight: 600;
  background: transparent;
  border-bottom-color: var(--accent);
  box-shadow: none;
}

/* ---------------- 区块标题 ---------------- */

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 46rpx 0 22rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
}

.section-more {
  font-size: 23rpx;
  color: var(--ink-3);
}

/* ---------------- 模板卡片 ---------------- */

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  position: relative;
  width: 48.5%;
  margin-bottom: 28rpx;
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: none;
}

.card-hover {
  opacity: 0.82;
}

.cover {
  position: relative;
  height: 330rpx;
  padding: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.cover::after {
  display: none;
}

.cover-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.cover-format {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  z-index: 2;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #ffffff;
  background: rgba(25, 27, 30, 0.56);
}

.cover-title {
  position: relative;
  z-index: 2;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 600;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-body {
  padding: 18rpx 20rpx 22rpx;
}

.card-title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 600;
}

.card-meta {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  font-size: 21rpx;
  color: var(--ink-3);
}

/* 封面占位色：低饱和的纸面配色 */
.tone-blue { background: #31465f; }
.tone-indigo { background: #454363; }
.tone-green { background: #335a4d; }
.tone-orange { background: #8a4c32; }
.tone-pink { background: #744256; }
.tone-slate { background: #3b434d; }
.tone-teal { background: #2f5a58; }
.tone-purple { background: #4f4564; }

/* ---------------- 空态 / 列表提示 ---------------- */

.empty {
  padding: 96rpx 40rpx;
  text-align: center;
  color: var(--ink-3);
  font-size: 25rpx;
  line-height: 1.7;
}

.footer-tip {
  margin-top: 44rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-3);
}

.list-tip {
  margin: 28rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
}

.tabbar-pad {
  height: 180rpx;
}

/* 通用小按钮 */
.btn-dark {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: var(--radius-sm);
  font-size: 27rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--ink);
  border: none;
}

.btn-dark::after {
  border: none;
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--ink);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
}

.btn-outline::after {
  border: none;
}

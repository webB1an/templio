/* ============================================================
   模板宝小程序 · 全局样式
   设计方向：苹果液态玻璃（Liquid Glass）+ 模板内容优先
   - 柔和浅色底 + 半透明磨砂玻璃层
   - 系统蓝强调色，细高光边框与轻阴影
   ============================================================ */

page {
  --ink: #1c1c1e;
  --ink-2: #5b5f66;
  --ink-3: #8e8e93;
  --line: rgba(60, 60, 67, 0.12);
  --line-strong: rgba(60, 60, 67, 0.2);
  --accent: #0a84ff;
  --accent-ink: #0060df;
  --accent-soft: rgba(10, 132, 255, 0.12);
  --glass: rgba(255, 255, 255, 0.62);
  --glass-strong: rgba(255, 255, 255, 0.78);
  --glass-border: rgba(255, 255, 255, 0.76);

  min-height: 100vh;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  background-color: #f2f4f8;
  background-image:
    radial-gradient(900rpx 620rpx at -12% -10%, rgba(122, 168, 255, 0.3), transparent 64%),
    radial-gradient(820rpx 620rpx at 112% 8%, rgba(255, 158, 202, 0.18), transparent 62%),
    radial-gradient(760rpx 700rpx at 48% 112%, rgba(126, 230, 218, 0.16), transparent 62%),
    linear-gradient(180deg, #f6f8fc 0%, #f1f3f8 52%, #f7f5fa 100%);
  background-attachment: fixed;
  -webkit-font-smoothing: antialiased;
}

.bg-orb {
  display: none !important;
}

/* ---------------- 页面骨架 ---------------- */

.page {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 0 32rpx 260rpx;
  box-sizing: border-box;
}

/* 首页有底部固定分类栏，多留一点空间 */
.home-page {
  padding-bottom: 340rpx;
}

.hero {
  padding: 10rpx 0 0;
}

.hero-title {
  display: block;
  font-size: 50rpx;
  line-height: 1.26;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.hero-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

/* ---------------- 玻璃 ---------------- */

.glass {
  background: var(--glass);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  border-radius: 28rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 14rpx 34rpx rgba(31, 58, 100, 0.08);
}

.glass-pill {
  border-radius: 999rpx;
}

/* 列表行/下载记录小封面 */
.cover-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* ---------------- 导航 ---------------- */

.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  padding: 0 32rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.5);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  backdrop-filter: blur(30rpx) saturate(180%);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.66);
}

/* 吸顶时导航与分类栏共用这一块玻璃，避免两层背景产生接缝 */
.header-backdrop {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 17;
  pointer-events: none;
  background: rgba(255, 255, 255, 0.58);
  -webkit-backdrop-filter: blur(32rpx) saturate(180%);
  backdrop-filter: blur(32rpx) saturate(180%);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.68);
  box-shadow: 0 10rpx 24rpx rgba(31, 58, 100, 0.08);
}

.nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
}

/* 吸顶时导航本身透明，由 header-backdrop 统一提供玻璃背景 */
.nav-stuck {
  background: transparent;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  border-bottom: none;
}

.brand {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
  color: var(--ink);
}

.brand-sub {
  margin-left: 12rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--ink-3);
}

.nav-back {
  width: 68rpx;
  height: 68rpx;
  margin-left: -16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 42rpx;
  line-height: 1;
  color: var(--ink);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 29rpx;
  font-weight: 600;
}

.nav-placeholder {
  width: 68rpx;
  height: 68rpx;
}

/* ---------------- 搜索条 ---------------- */

.search {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 26rpx;
  margin-top: 30rpx;
  border-radius: 999rpx;
  background: var(--glass);
  -webkit-backdrop-filter: blur(28rpx) saturate(180%);
  backdrop-filter: blur(28rpx) saturate(180%);
  border: 1rpx solid var(--glass-border);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 10rpx 26rpx rgba(31, 58, 100, 0.07);
}

.search-icon {
  margin-right: 14rpx;
  font-size: 30rpx;
  color: var(--ink-3);
}

.search-text {
  font-size: 26rpx;
  color: var(--ink-3);
}

/* ---------------- 模板类型（列表上方，滚动吸顶） ---------------- */

.type-bar-holder {
  height: 104rpx;
  margin-top: 22rpx;
}

.type-bar {
  height: 104rpx;
  padding: 10rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.58);
  -webkit-backdrop-filter: blur(32rpx) saturate(180%);
  backdrop-filter: blur(32rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95), 0 12rpx 30rpx rgba(31, 58, 100, 0.08);
}

/* 吸顶后与顶部导航共用 header-backdrop，自身不再绘制背景 */
.type-bar-stuck {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 18;
  height: 96rpx;
  padding: 8rpx 32rpx;
  border-radius: 0;
  border: none;
  background: transparent;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
  box-shadow: none;
}

.type-scroll {
  width: 100%;
  height: 84rpx;
  white-space: nowrap;
}

.type-bar-stuck .type-scroll {
  height: 80rpx;
}

.type-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 28rpx;
  margin-right: 4rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: var(--ink-2);
}

.type-item:last-child {
  margin-right: 0;
}

.type-active {
  color: #ffffff;
  font-weight: 600;
  background: rgba(10, 132, 255, 0.94);
  box-shadow: 0 8rpx 20rpx rgba(10, 132, 255, 0.28);
}

/* 吸顶状态：改为顶部导航式下划线，不再是大胶囊 */
.type-bar-stuck .type-item {
  position: relative;
  height: 80rpx;
  margin-right: 40rpx;
  padding: 0;
  border-radius: 0;
  font-size: 25rpx;
  color: var(--ink-2);
  background: transparent;
  box-shadow: none;
}

.type-bar-stuck .type-active {
  color: var(--accent);
  font-weight: 600;
  background: transparent;
  box-shadow: none;
}

.type-bar-stuck .type-active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 30rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--accent);
  transform: translateX(-50%);
}

/* ---------------- 区块标题 ---------------- */

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44rpx 4rpx 20rpx;
}

.section-title {
  font-size: 33rpx;
  font-weight: 700;
  letter-spacing: -0.4rpx;
}

.section-more {
  font-size: 23rpx;
  color: var(--ink-3);
}

/* ---------------- 模板网格 ---------------- */

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  width: 48.6%;
  margin-bottom: 24rpx;
}

/* ---------------- 占位/提示 ---------------- */

.empty {
  padding: 96rpx 40rpx;
  text-align: center;
  color: var(--ink-3);
  font-size: 25rpx;
  line-height: 1.7;
  background: var(--glass);
  -webkit-backdrop-filter: blur(26rpx);
  backdrop-filter: blur(26rpx);
  border: 1rpx solid var(--glass-border);
  border-radius: 28rpx;
}

.footer-tip {
  margin-top: 42rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-3);
}

.list-tip {
  margin: 26rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
}

.tabbar-pad {
  height: 0;
}

/* ---------------- 按钮 ---------------- */

.btn-dark {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #ffffff;
  background: rgba(10, 132, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(10, 132, 255, 0.26);
  border: none;
}

.btn-dark::after {
  border: none;
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--ink);
  background: var(--glass);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
  border: 1rpx solid var(--glass-border);
}

.btn-outline::after {
  border: none;
}

/* 下载记录等小封面色 */
.tone-blue { background: linear-gradient(135deg, #2f5d9e 0%, #6ba4ef 100%); }
.tone-indigo { background: linear-gradient(135deg, #4a4a82 0%, #8f92d8 100%); }
.tone-green { background: linear-gradient(135deg, #2f6a54 0%, #7dc4a4 100%); }
.tone-orange { background: linear-gradient(135deg, #9a5334 0%, #d99a73 100%); }
.tone-pink { background: linear-gradient(135deg, #8a4660 0%, #d795ae 100%); }
.tone-slate { background: linear-gradient(135deg, #414a58 0%, #8996a8 100%); }
.tone-teal { background: linear-gradient(135deg, #2f6460 0%, #86c8c0 100%); }
.tone-purple { background: linear-gradient(135deg, #5b4a7e 0%, #a898d8 100%); }

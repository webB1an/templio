<view class="tcard" bindtap="onOpen" hover-class="tcard-hover">
  <view class="tcard-cover tone-{{item.tone}}">
    <image wx:if="{{imageUrl}}" class="tcard-img" src="{{imageUrl}}" mode="aspectFill" lazy-load />
    <view wx:else class="tcard-fallback">
      <view class="tcard-fallback-panel"></view>
      <text class="tcard-fallback-format">{{formatLabel}}</text>
    </view>
    <view wx:if="{{viewCountText}}" class="tcard-views">
      <text class="tcard-eye">◉</text>
      <text>{{viewCountText}}</text>
    </view>
    <view wx:if="{{removable}}" class="tcard-remove" catchtap="onRemove">移除</view>
  </view>

  <view class="tcard-body">
    <view class="tcard-author">
      <image class="tcard-avatar" src="/assets/logo.png" mode="aspectFill" />
      <text class="tcard-author-name">模板宝</text>
      <text class="tcard-type">{{formatLabel}}</text>
    </view>
    <text class="tcard-title">{{item.title}}</text>
    <view class="tcard-meta">
      <text>{{item.category}}</text>
      <text>{{item.pageCount}} 页</text>
    </view>
  </view>
</view>

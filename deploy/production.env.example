# 生产环境变量模板
# 部署到服务器：/www/wwwroot/templio/apps/api/.env（chmod 600）
# 注意：该文件不会被 CI 覆盖（rsync 排除 .env），请只在服务器上维护。

NODE_ENV=production
PORT=4000

# 数据库（宝塔 MySQL 8，待创建 templio 数据库后填写）
DATABASE_URL=mysql://templio_user:CHANGE_ME@127.0.0.1:3306/templio

# 管理端登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 存储（封面/预览长期保存；源文件临时区）
STORAGE_ROOT=/www/wwwroot/templio/storage
INCOMING_QUOTA_GB=8

# 网盘 Skill（Linux 服务器）
BDPAN_PATH=bdpan
QUARK_SKILL_DIR=

# 短链与小程序
SHORT_LINK_ORIGIN=
MINIPROGRAM_APPID=
WECHAT_APP_SECRET=

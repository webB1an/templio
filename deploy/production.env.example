# 生产环境变量模板
# 部署到服务器：/www/wwwroot/templio/apps/api/.env（chmod 600）
# 注意：该文件不会被 CI 覆盖（rsync 排除 .env），请只在服务器上维护。

NODE_ENV=production
PORT=4000

# 数据库（宝塔 MySQL 8，待创建 templio 数据库后填写）
DATABASE_URL=mysql://templio_user:CHANGE_ME@127.0.0.1:3306/templio

# 管理端登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# DeepSeek 平价时段自动标注
# 工作日空闲：00:00-09:00、12:00-14:00、18:00-24:00；周末和法定节假日全天
AI_AUTO_ENABLED=true
AI_AUTO_MIN_CONFIDENCE=0.85
AI_AUTO_DELAY_MS=2500
# 可选：工作日法定节假日，逗号分隔 YYYY-MM-DD
AI_AUTO_HOLIDAYS=

# 存储（封面/预览长期保存；源文件临时区）
STORAGE_ROOT=/www/wwwroot/templio/storage
INCOMING_QUOTA_GB=8

# 网盘 Skill（Linux 服务器）
BDPAN_PATH=bdpan
QUARK_SKILL_DIR=
BAIDU_REMOTE_BASE=/apps/bdpan/templio
BAIDU_SHARE_PERIOD_DAYS=0
QUARK_UPLOAD_PARENT_FID=
STORAGE_ACCOUNT_ROOT=

# 网盘自动同步命令（可选）：支持 {file} {provider} 占位符；
# 命令 stdout 需输出 JSON，例如 {"url":"https://pan.baidu.com/s/xxx","passcode":"abcd"}
NETDISK_SYNC_COMMAND=
# 同步成功后是否删除服务器暂存源文件（默认 true）
DELETE_SOURCE_AFTER_SYNC=true

# 短链与小程序
APP_ORIGIN=https://templio.wdbzk.com
SHORT_LINK_ORIGIN=
MINIPROGRAM_APPID=
WECHAT_APP_SECRET=

# 可选：健康检查告警 webhook（企业微信/飞书等 text webhook）
ALERT_WEBHOOK_URL=

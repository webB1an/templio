# Templio 生产 Nginx 配置示例
# 宝塔路径：/www/server/panel/vhost/nginx/templio.wdbzk.com.conf
#
# 证书由 acme.sh 签发（Let's Encrypt），安装路径：
#   /www/server/panel/vhost/cert/templio.wdbzk.com/{fullchain.pem,privkey.pem}
#
# 部署前：
#   1. 域名解析到服务器 IP
#   2. 微信小程序后台把 https://templio.wdbzk.com 加入 request 合法域名

server {
    listen 80;
    server_name templio.wdbzk.com;

    # ACME HTTP-01 校验（Let's Encrypt / acme.sh）
    location /.well-known/acme-challenge/ {
        root /www/wwwroot/templio/acme-challenge;
        try_files $uri =404;
    }

    # 其余请求强制 HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name templio.wdbzk.com;

    ssl_certificate     /www/server/panel/vhost/cert/templio.wdbzk.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/templio.wdbzk.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # 源文件分片上传：单请求上限（按分片大小调整）
    client_max_body_size 108m;

    # Web 管理端（React 构建产物，后续实现）
    location /admin/ {
        alias /www/wwwroot/templio/apps/admin/dist/;
        try_files $uri $uri/ /admin/index.html;
    }

    # 封面 / 缩略图 / 预览图：长期强缓存（文件名带 hash）
    location /assets/ {
        alias /www/wwwroot/templio/storage/public/;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # 健康检查
    location = /health {
        proxy_pass http://127.0.0.1:4000/health;
        proxy_set_header Host $host;
    }

    # 公开 API（小程序 request 域名）
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # 网盘短链跳转
    location /r/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # 其它路径：占位页
    location / {
        default_type text/plain;
        return 200 "Templio server is running\n";
    }
}

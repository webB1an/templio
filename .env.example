# ── 服务端 ──
# 本地开发通过 SSH 隧道连线上库：npm run tunnel:db（3307→3306，6380→6379）
# 线上部署时改为 127.0.0.1:3306 / 127.0.0.1:6379
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3307/templio"
REDIS_URL="redis://127.0.0.1:6380/0"
PORT=3000

# 会话签名密钥（上线前必须换成强随机值）
JWT_SECRET="change-me"

# ── 微信小程序 ──
WX_APPID="wx5f21980e48e92ae6"
# 小程序 AppSecret（公众平台 → 开发设置），只放服务器
WX_APP_SECRET=""

# ── 虚拟支付（公众平台 → 虚拟支付 → 基本配置），只放服务器 ──
WX_VIRTUAL_PAY_OFFER_ID=""
WX_VIRTUAL_PAY_APP_KEY=""
# 支付回调 Token / EncodingAESKey（发货通知配置）
WX_PAY_NOTIFY_TOKEN=""
WX_PAY_NOTIFY_AES_KEY=""

# ── AI（DeepSeek，图片识别用 deepseek-flash）──
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"

# ── 监控告警（飞书群机器人）──
FEISHU_WEBHOOK_URL=""

# ── 网盘（沿用 wallpaper-manager 登录态方式）──
QUARK_COOKIE=""
BAIDU_COOKIE=""

# ── M3：mock 开关（联调用，生产必须 false）──
MOCK_AUTH="false"
MOCK_PAY="false"
